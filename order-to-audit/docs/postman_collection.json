        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Murukku BOM {{$timestamp}}\",\n  \"batchOutputKg\": 40,\n  \"items\": [\n    {\"materialId\": {{flourId}}, \"quantity\": 40, \"basis\": \"PER_BATCH\"},\n    {\"materialId\": {{oilId}}, \"quantity\": 10, \"basis\": \"PER_BATCH\"},\n    {\"materialId\": {{spiceId}}, \"quantity\": 1.2, \"basis\": \"PER_BATCH\"},\n    {\"materialId\": {{pouchId}}, \"quantity\": 200, \"basis\": \"PER_BATCH\"},\n    {\"materialId\": {{cartonId}}, \"quantity\": 10, \"basis\": \"PER_BATCH\"}\n  ]\n}"
